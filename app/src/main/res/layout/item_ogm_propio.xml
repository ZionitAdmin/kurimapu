<?xml version="1.0" encoding="utf-8"?>
<!-- TICKET 2512 - 2026-09-29: tarjeta de anexo de la pantalla "Ver OGM propios" (OgmPropiosAdapter) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="2dp"
    android:layout_marginTop="8dp"
    android:layout_marginEnd="2dp"
    android:layout_marginBottom="2dp"
    android:background="@drawable/ogm_card"
    android:elevation="2dp"
    android:orientation="horizontal">

    <!-- franja de color: roja = sin visita, verde = visitado -->
    <View
        android:id="@+id/ogm_item_franja"
        android:layout_width="4dp"
        android:layout_height="match_parent"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/ogm_redondeado" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/ogm_item_anexo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/ogm_texto"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- etiqueta de estado con icono: Sin visita / SPV / CPV -->
            <TextView
                android:id="@+id/ogm_item_estado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/ogm_redondeado"
                android:drawablePadding="4dp"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="10dp"
                android:paddingBottom="3dp"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/ogm_item_agricultor"
            style="@style/OgmDatoCard"
            android:layout_width="match_parent"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/ogm_texto"
            android:textSize="13sp"
            android:drawableStart="@drawable/ic_ogm_agricultor" />

        <!-- datos del anexo con icono; ChipGroup se usa solo como contenedor que salta de linea -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/ogm_item_datos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:chipSpacingHorizontal="12dp"
            app:chipSpacingVertical="4dp">

            <TextView
                android:id="@+id/ogm_item_comuna"
                style="@style/OgmDatoCard"
                android:drawableStart="@drawable/ic_ogm_ubicacion" />

            <TextView
                android:id="@+id/ogm_item_especie"
                style="@style/OgmDatoCard"
                android:drawableStart="@drawable/ic_ogm_especie" />

            <TextView
                android:id="@+id/ogm_item_temporada"
                style="@style/OgmDatoCard"
                android:drawableStart="@drawable/ic_ogm_temporada" />

            <TextView
                android:id="@+id/ogm_item_cuatrimestre"
                style="@style/OgmDatoCard"
                android:drawableStart="@drawable/ic_ogm_cuatrimestre" />

            <TextView
                android:id="@+id/ogm_item_ultima_visita"
                style="@style/OgmDatoCard"
                android:drawableStart="@drawable/ic_ogm_ultima_visita" />
        </com.google.android.material.chip.ChipGroup>
    </LinearLayout>
</LinearLayout>
